---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Offset Print d.o.o." description="The page you were looking for doesn't exist.">
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="uppercase tracking-[0.2em] text-xs text-accent font-medium">404</p>
    <h1 class="text-5xl font-semibold tracking-tight mt-3">Page not found</h1>
    <p class="text-ink-muted mt-6">The page you were looking for has moved or never existed.</p>
    <a href="/" class="inline-block mt-8 px-5 py-3 bg-ink text-paper text-sm hover:bg-accent transition-colors">Back to home</a>
  </section>
</Base>
