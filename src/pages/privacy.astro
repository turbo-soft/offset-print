---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const entry = await getEntry("privacy", "privacy");
if (!entry) throw new Error("Missing content/pages/privacy.md");
const { Content } = await render(entry);
---
<Base
  title={entry.data.seo?.title ?? `${entry.data.title} — Offset Print d.o.o.`}
  description={entry.data.seo?.description}
>
  <article class="border-b border-rule">
    <div class="mx-auto max-w-7xl px-6 py-12 md:py-16 grid md:grid-cols-12 gap-6">
      <div class="md:col-span-4">
        <p class="label mb-2">// 05 / Legal</p>
        <p class="font-mono text-xs text-ink-muted">Last updated: {entry.data.last_updated}</p>
      </div>
      <div class="md:col-span-7">
        <h1 class="heading text-4xl md:text-5xl mb-8 md:mb-10">{entry.data.title}</h1>
        <div class="prose max-w-none [&_h2]:heading [&_h2]:text-2xl [&_h2]:mt-10 [&_h2]:mb-3 [&_p]:mt-4 [&_p]:leading-relaxed [&_p]:text-ink-muted [&_code]:font-mono [&_code]:bg-paper [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
