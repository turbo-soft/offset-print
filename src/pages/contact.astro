---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";

const contact = await getEntry("contact", "contact");
if (!contact) throw new Error("Missing content/pages/contact.md");
const { data } = contact;
const mapHref = `https://www.openstreetmap.org/?mlat=${data.map_lat}&mlon=${data.map_lng}#map=${data.map_zoom}/${data.map_lat}/${data.map_lng}`;
const tilesUrl = `https://tile.openstreetmap.org/${data.map_zoom}/${Math.floor((data.map_lng + 180) / 360 * Math.pow(2, data.map_zoom))}/${Math.floor((1 - Math.log(Math.tan(data.map_lat * Math.PI / 180) + 1 / Math.cos(data.map_lat * Math.PI / 180)) / Math.PI) / 2 * Math.pow(2, data.map_zoom))}.png`;
---
<Base
  title={data.seo?.title ?? "Contact — Offset Print d.o.o."}
  description={data.seo?.description}
>
  <section class="border-b border-rule">
    <div class="mx-auto max-w-7xl px-6 py-12 md:py-16 grid md:grid-cols-12 gap-6">
      <div class="md:col-span-4">
        <p class="label mb-3">// 04 / Contact</p>
      </div>
      <div class="md:col-span-8">
        <h1 class="heading text-4xl sm:text-5xl md:text-7xl">Get in touch.</h1>
        <p class="text-lg md:text-xl text-ink-muted leading-relaxed mt-5 md:mt-6 max-w-2xl">{data.form_intro}</p>
      </div>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-7xl px-6 py-10 md:py-12 grid md:grid-cols-12 gap-6 md:gap-10 items-start">
      <div class="md:col-span-5 space-y-6">
        <div class="bg-paper border border-rule rounded-xl p-5">
          <p class="label mb-2">// Address</p>
          <p class="heading text-base">Offset Print d.o.o.</p>
          <p class="font-mono text-sm">{data.address_line1}<br />{data.address_line2}</p>
          <a
            href={mapHref}
            target="_blank"
            rel="noopener"
            class="inline-block mt-3 text-sm border-b border-ink hover:text-accent-warm hover:border-accent-warm"
          >
            Open in OpenStreetMap →
          </a>
        </div>
        <div class="bg-paper border border-rule rounded-xl p-5">
          <p class="label mb-2">// Telecom</p>
          <ul class="font-mono text-sm space-y-1">
            {data.phones.map((p) => <li><a href={`tel:${p.replace(/\s+/g, "")}`}>{p}</a></li>)}
            <li><a href={`mailto:${data.email}`}>{data.email}</a></li>
          </ul>
          {data.fax && <p class="font-mono text-sm mt-2"><span class="label">Fax</span> {data.fax}</p>}
        </div>
        <div class="bg-paper border border-rule rounded-xl overflow-hidden">
          <a href={mapHref} target="_blank" rel="noopener" aria-label="View location on OpenStreetMap">
            <img
              src={tilesUrl}
              alt={`Map showing ${data.address_line1}, ${data.address_line2}`}
              width="256"
              height="256"
              class="w-full h-64 object-cover"
              loading="lazy"
            />
          </a>
        </div>
      </div>
      <div class="md:col-span-7 bg-paper border border-rule rounded-xl p-5 md:p-6">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
