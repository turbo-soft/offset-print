---
// Click-to-zoom modal. Picks up any element with data-zoom that lives inside
// a [data-slider]; reads the slider's images as the gallery sequence.
---
<div
  data-lightbox
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Image preview"
  class="fixed inset-0 z-[60] flex items-center justify-center bg-ink/95 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200 data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto"
>
  <button
    type="button"
    data-lightbox-close
    class="absolute top-4 right-4 md:top-6 md:right-6 grid place-items-center size-11 md:size-12 rounded-full bg-paper/10 text-paper hover:bg-paper hover:text-ink transition-colors"
    aria-label="Close image preview"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6l-12 12" />
    </svg>
  </button>

  <button
    type="button"
    data-lightbox-prev
    class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 grid place-items-center size-11 md:size-12 rounded-full bg-paper/10 text-paper hover:bg-paper hover:text-ink transition-colors disabled:opacity-25 disabled:cursor-not-allowed"
    aria-label="Previous image"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M15 18l-6-6 6-6" />
    </svg>
  </button>

  <button
    type="button"
    data-lightbox-next
    class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 grid place-items-center size-11 md:size-12 rounded-full bg-paper/10 text-paper hover:bg-paper hover:text-ink transition-colors disabled:opacity-25 disabled:cursor-not-allowed"
    aria-label="Next image"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M9 6l6 6-6 6" />
    </svg>
  </button>

  <figure class="relative max-w-[92vw] max-h-[80vh] md:max-h-[85vh]">
    <img
      data-lightbox-img
      src=""
      alt=""
      class="max-w-[92vw] max-h-[80vh] md:max-h-[85vh] object-contain"
    />
  </figure>

  <div
    data-lightbox-counter
    class="absolute bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 font-mono text-xs text-paper/80 bg-ink/40 px-3 py-1 rounded-full backdrop-blur"
  ></div>
</div>

<script>
  type Item = { src: string; alt: string };

  const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
  if (lightbox) {
    const imgEl = lightbox.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const counterEl = lightbox.querySelector<HTMLElement>("[data-lightbox-counter]");
    const prevBtn = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
    const nextBtn = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-next]");
    const closeBtn = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-close]");

    let gallery: Item[] = [];
    let index = 0;
    let lastFocused: HTMLElement | null = null;

    const render = () => {
      const item = gallery[index];
      if (!item || !imgEl || !counterEl || !prevBtn || !nextBtn) return;
      imgEl.src = item.src;
      imgEl.alt = item.alt;
      counterEl.textContent = `${index + 1} / ${gallery.length}`;
      prevBtn.disabled = index <= 0;
      nextBtn.disabled = index >= gallery.length - 1;
    };

    const open = (g: Item[], i: number) => {
      gallery = g;
      index = i;
      lastFocused = document.activeElement as HTMLElement;
      lightbox.dataset.open = "true";
      document.body.style.overflow = "hidden";
      render();
      closeBtn?.focus();
    };

    const close = () => {
      lightbox.dataset.open = "false";
      document.body.style.overflow = "";
      if (imgEl) imgEl.src = "";
      lastFocused?.focus();
    };

    const go = (delta: number) => {
      const n = index + delta;
      if (n < 0 || n >= gallery.length) return;
      index = n;
      render();
    };

    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement)?.closest<HTMLElement>("[data-zoom]");
      if (!target) return;
      e.preventDefault();
      const slider = target.closest<HTMLElement>("[data-slider]");
      const triggers = slider
        ? Array.from(slider.querySelectorAll<HTMLElement>("[data-zoom]"))
        : [target];
      const items: Item[] = triggers.map((t) => {
        const img = t.querySelector<HTMLImageElement>("img");
        return { src: img?.src ?? "", alt: img?.alt ?? "" };
      });
      open(items, triggers.indexOf(target));
    });

    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => go(-1));
    nextBtn?.addEventListener("click", () => go(1));

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener("keydown", (e) => {
      if (lightbox.dataset.open !== "true") return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") go(-1);
      else if (e.key === "ArrowRight") go(1);
    });

    lightbox.addEventListener("keydown", (e) => {
      if (e.key !== "Tab" || lightbox.dataset.open !== "true") return;
      const focusable = Array.from(
        lightbox.querySelectorAll<HTMLElement>("button:not([disabled])")
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
